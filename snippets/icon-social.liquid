{%- liquid
  case platform
    when 'instagram'
      assign asset_name = 'instagram.svg'
    when 'x'
      assign asset_name = 'x.svg'
    else
      assign asset_name = 'facebook.svg'
  endcase
-%}

<img
  class="block size-11 md:size-9"
  src="{{ asset_name | asset_url }}"
  alt=""
  width="44"
  height="44"
  loading="lazy"
  aria-hidden="true"
>
