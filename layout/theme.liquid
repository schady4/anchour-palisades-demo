<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    {% # Self-hosted stand-ins for TT Commons Pro / TT Hoves Pro %}
    {% render 'fonts' %}

    {% # The only stylesheet; Tailwind's Preflight is the reset %}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # Must evaluate before Alpine's core boots %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'alpine.min.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="flex min-h-svh flex-col">
    <a class="sr-only focus:not-sr-only focus:absolute focus:m-4 focus:rounded focus:bg-white focus:p-3" href="#main-content">
      Skip to content
    </a>

    <main id="main-content" class="flex-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
