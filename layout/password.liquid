<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% render 'fonts' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {% render 'meta-tags' %}
    {{ content_for_header }}
  </head>
  <body class="font-body">
    <main class="mx-auto max-w-site p-6">{{ content_for_layout }}</main>
  </body>
</html>
